<mxfile host="app.diagrams.net">
  <diagram name="Vertex AI Self-Service Platform">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- USER -->
        <mxCell id="user" value="User (Data Scientist)" style="shape=rectangle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- GITHUB ACTIONS -->
        <mxCell id="github" value="GitHub Actions&#xa;(workflow_dispatch)" style="shape=rectangle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="220" y="200" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- TERRAFORM -->
        <mxCell id="terraform" value="Terraform&#xa;(init / plan / apply)" style="shape=rectangle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="460" y="200" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- GCP BOX -->
        <mxCell id="gcp" value="Google Cloud Platform" style="shape=rectangle;rounded=1;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="500" height="400" as="geometry"/>
        </mxCell>

        <!-- WORKBENCH -->
        <mxCell id="workbench" value="Vertex AI Workbench&#xa;(Private IP Only)" style="shape=rectangle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="gcp">
          <mxGeometry x="150" y="150" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- RUNTIME SA -->
        <mxCell id="runtime" value="Runtime Service Account" style="shape=rectangle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="gcp">
          <mxGeometry x="150" y="260" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- IAM -->
        <mxCell id="iam" value="IAM Binding&#xa;(instance_owners)" style="shape=rectangle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="gcp">
          <mxGeometry x="150" y="60" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- IAP -->
        <mxCell id="iap" value="Identity-Aware Proxy (IAP)" style="shape=rectangle;fillColor=#cce5ff;strokeColor=#004085;" vertex="1" parent="gcp">
          <mxGeometry x="380" y="150" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- PROXY URL -->
        <mxCell id="proxy" value="Terraform Output&#xa;proxy_uri&#xa;(Notebook URL)" style="shape=rectangle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="320" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- DELETE WORKFLOW -->
        <mxCell id="delete" value="Delete Workflow&#xa;(Self-Service)" style="shape=rectangle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="320" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- CONNECTIONS -->
        <mxCell id="e1" edge="1" parent="1" source="user" target="github">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" edge="1" parent="1" source="github" target="terraform">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" edge="1" parent="1" source="terraform" target="workbench">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" edge="1" parent="1" source="terraform" target="proxy">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ACCESS FLOW -->
        <mxCell id="e5" edge="1" parent="1" source="user" target="proxy">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" edge="1" parent="gcp" source="proxy" target="iap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" edge="1" parent="gcp" source="iap" target="iam">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e8" edge="1" parent="gcp" source="iam" target="workbench">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- DELETE FLOW -->
        <mxCell id="e9" edge="1" parent="1" source="user" target="delete">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e10" edge="1" parent="1" source="delete" target="terraform">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>